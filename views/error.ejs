<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-rick text-gray-900">
    <main class="max-w-xl mx-auto p-8 bg-white shadow-md rounded-lg mt-10">
        <h1 class="text-3xl font-bold text-red-600 mb-4">Oops! Something went wrong.</h1>
        <p class="text-gray-700 mb-4">We're sorry, but an unexpected error occurred.</p>

        <% if (error) { %>
            <h2 class="text-xl font-semibold text-gray-800 mb-2">Error Details:</h2>
            <pre class="bg-gray-100 p-4 rounded overflow-auto text-sm text-red-800"><%= error.message %></pre>
            <% if (error.stack) { %>
                <h3 class="text-lg font-semibold text-gray-800 mt-4 mb-2">Stack Trace:</h3>
                <pre class="bg-gray-100 p-4 rounded overflow-auto text-xs text-red-700"><%= error.stack %></pre>
                <% } %>
                    <% } else { %>
                        <p class="text-gray-700">Please try again later or contact support if the problem persists.</p>
                        <% } %>

                            <div class="mt-6">
                                <a href="/" class="text-blue-500 hover:underline">Go to Home Page</a>
                            </div>
    </main>
</body>

</html>